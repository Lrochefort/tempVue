{
  "name": "tempvue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tempvue/web dev",
    "dev:lab": "pnpm --filter @tempvue/vfm-lab dev",
    "build": "pnpm --filter @tempvue/utils build && pnpm --filter @tempvue/web build && pnpm --filter @tempvue/vfm-lab build",
    "preview": "pnpm --filter @tempvue/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @tempvue/vfm-lab test:e2e",
    "test:e2e:ui": "pnpm --filter @tempvue/vfm-lab test:e2e:ui",
    "test:e2e:report": "pnpm --filter @tempvue/vfm-lab test:e2e:report",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r --parallel typecheck",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:all": "pnpm run check && pnpm run test:e2e",
    "clean": "rimraf --glob coverage \"apps/*/dist\" \"packages/*/dist\""
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "^6.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.13.1"
}
