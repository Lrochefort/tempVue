{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["@/", "@tempvue/"],
    "newlinesBetween": true
  },
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "**/node_modules/**", "pnpm-lock.yaml"]
}
